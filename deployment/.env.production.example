# SafeStep Production Environment Configuration Template
NODE_ENV=production
DEMO_MODE=false
PORT=4080

# Database Password (Postgres)
DB_PASSWORD=ChangeThisToStrongPostgresPassword2026!

# Cryptographic Secrets (Generate each using: openssl rand -hex 32)
JWT_ACCESS_SECRET=GenerateWithOpenSSL_64_Character_Hex_Key_Access
JWT_REFRESH_SECRET=GenerateWithOpenSSL_64_Character_Hex_Key_Refresh
INVITE_CODE_PEPPER=GenerateWithOpenSSL_64_Character_Hex_Key_Pepper
IDENTITY_DATA_ENCRYPTION_KEY=GenerateWithOpenSSL_32_Bytes_Hex_Key_Encryption

# Domain Configuration
CORS_ORIGINS=https://YOUR_DOMAIN.ir

# Push Notification Service
NOTIFICATION_DRIVER=fcm
FCM_SERVICE_ACCOUNT_PATH=/run/secrets/safestep-fcm-service-account.json
